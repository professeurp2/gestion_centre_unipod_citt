# Copier en .env (ou définir ces variables dans le service système).
DJANGO_SECRET_KEY=remplacer-par-une-longue-valeur-aleatoire
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=192.168.1.10,unipod.local
DJANGO_CSRF_TRUSTED_ORIGINS=
# false si le site est servi en http:// sur le réseau local (pas de certificat)
DJANGO_HTTPS=false
# Emplacement de la base SQLite et des sauvegardes (facultatif)
SQLITE_PATH=/srv/unipod/donnees/db.sqlite3
SAUVEGARDE_DIR=/srv/unipod/sauvegardes
# PostgreSQL : seulement si un serveur gratuit existe déjà (laisser vide sinon)
POSTGRES_DB=
